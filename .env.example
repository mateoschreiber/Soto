# Copy to .env or define these variables in Portainer. No secrets are required.
SOTO_IMAGE=ghcr.io/mateoschreiber/soto:0.1.0-alpha.1
# 127.0.0.1: same-host proxy or SSH tunnel; set the server LAN IPv4 for LAN clients.
# 0.0.0.0 publishes on all IPv4 interfaces; use only on a trusted network.
SOTO_HOST_IP=127.0.0.1
SOTO_PORT=3000
SOTO_MEMORY_LIMIT=128m
SOTO_CPU_LIMIT=0.50
RUST_LOG=soto_server=info,tower_http=warn
