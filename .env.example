# Copy to .env or define these variables in Portainer. Credentials are configured after installation.
SOTO_IMAGE=ghcr.io/mateoschreiber/soto:0.2.0-alpha.2
SOTO_WORKER_IMAGE=ghcr.io/mateoschreiber/soto:0.2.0-alpha.2-worker
# 127.0.0.1: same-host proxy or SSH tunnel; set the server LAN IPv4 for LAN clients.
# 0.0.0.0 publishes on all IPv4 interfaces; use only on a trusted network.
SOTO_HOST_IP=127.0.0.1
SOTO_PORT=3000
SOTO_MEMORY_LIMIT=256m
SOTO_CPU_LIMIT=0.50
SOTO_WORKER_MEMORY_LIMIT=1g
SOTO_WORKER_CPU_LIMIT=1.0
# Host path containing local media (including SMB/NFS mounted on the HOST).
SOTO_LOCAL_PATH=./media/local
# Set to the exact https:// origin when running behind your reverse proxy.
SOTO_PUBLIC_URL=
RUST_LOG=soto_server=info,tower_http=warn
